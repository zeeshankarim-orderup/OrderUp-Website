# Server-only SMTP settings. Never use NEXT_PUBLIC_ for these variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@orderup.sa
SUPPORT_EMAIL=support@orderup.sa
# For Gmail use an app password; the account must allow the SMTP_FROM address.
# Alternatively port 587 with SMTP_SECURE=false requires STARTTLS.
